{
  "name": "remove-bg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run ort:copy && npm run wasm:build && tsc -b && vite build",
    "preview": "vite preview",
    "postinstall": "npm run ort:copy",
    "ort:copy": "node scripts/copy-ort-runtime.mjs",
    "models:download": "node scripts/download-models.mjs",
    "test:e2e": "playwright test tests/e2e/editor.spec.ts tests/e2e/mobile.spec.ts",
    "test:e2e:inference": "playwright test tests/e2e/inference.spec.ts --config=playwright.production.config.ts",
    "test:e2e:report": "playwright show-report",
    "wasm:build": "wasm-pack build wasm --target web --out-dir ../src/lib/wasm/pkg",
    "wasm:build:dev": "wasm-pack build wasm --target web --dev --out-dir ../src/lib/wasm/pkg"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "onnxruntime-web": "1.29.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "postcss": "latest",
    "tailwindcss": "^3.4.17",
    "typescript": "latest"
  }
}
